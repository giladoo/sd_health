<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="patients_list" model="ir.ui.view">
        <field name="name">Patients</field>
        <field name="model">sd_health.patients</field>
            <field name="arch" type="xml">
                <list >
                    <field name="name"/>
                    <field name="national_id"/>
                    <field name="gender"/>
                    <field name="birth_date"/>
                </list>
            </field>
    </record>

    <record id="patients_form" model="ir.ui.view">
        <field name="name">Patients</field>
        <field name="model">sd_health.patients</field>
            <field name="arch" type="xml">
                <form >
                    <sheet>
<!--                        <div class="oe_button_box" name="button_box"/>-->
<!--                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>-->
                        <field name="image" widget='image' class="oe_avatar" options='{"preview_image": "avatar_128"}'/>
                        <div class="oe_title mb24">
                            <h1>
                                <field name="name" placeholder="Name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="national_id"/>
                                <field name="gender"/>
                                <field name="birth_date"/>
                                <field name="age"/>
                                <field name="mobile_no"/>
                                <field name="emergency_phone"/>
                            </group>
                            <group>
                                <field name="height"/>
                                <field name="blood_group"/>
                                <field name="old_disease" widget="boolean_toggle"/>
                                <field name="present_disease" widget="boolean_toggle"/>
                                <field name="medication_records" widget="boolean_toggle"/>
                                <field name="drug_sensitivity" widget="boolean_toggle"/>
                                <field name="smoking_drug_history" widget="boolean_toggle"/>
                                <field name="surgery_hospitalization" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="e.g. Sight problem "/>
                        </group>
                        <field name="lab_result_id" >
                            <list delete="0" default_order="name desc">
                                <field name="record_date"/>
                                <button name="show_results"
                                        string="Results" type="object" class="btn btn-primary"/>
                                <button name="print_results" string="Print" type="object" class="btn btn-primary"/>

                            </list>
                        </field>
                    </sheet>
                    <chatter/>
                </form>
            </field>
    </record>

    <record id="patients_search" model="ir.ui.view">
        <field name="name">Medicine Inventory</field>
        <field name="model">sd_health.patients</field>
            <field name="arch" type="xml">
                <search >
                    <field name="national_id"/>
                    <field name="name"/>
<!--                    <field name="medicine_type"/>-->
<!--                    <field name="dose"/>-->
<!--                    <field name="quantity"/>-->
<!--                    <field name="receive_date"/>-->
<!--                    <filter name="medicine_name" string="Name" context="{'group_by': 'name'}"/>-->
                </search>
            </field>
    </record>

    <record id="patients_act_window" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">sd_health.patients</field>
        <field name="path">sdhealth</field>
        <field name="view_mode">list,form</field>
<!--        <field name="context">{'search_default_medicine_name': 1}</field>-->
    </record>


    <menuitem name="Health"
              id="health_menu"
              action="patients_act_window"
              groups="sd_health.group_users"/>

    <menuitem name="Configuration"
              id="configuration_menu"
              parent="health_menu"
              sequence="999"
              groups="sd_health.group_admins"/>

    <menuitem name="Patients"
              id="patients_menu"
              parent="health_menu"
              action="patients_act_window"
              groups="sd_health.group_doctors"/>

</odoo>