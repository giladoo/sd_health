<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="lab_results_list" model="ir.ui.view">
        <field name="name">Lab Results</field>
        <field name="model">sd_health.lab_results</field>
            <field name="arch" type="xml">
                <list >
                    <field name="patient_id"/>
                    <field name="age"/>
                    <field name="record_date"/>
                    <button name="show_results" string="Results" type="object" class="btn btn-primary"/>

                </list>
            </field>
    </record>

    <record id="lab_results_form" model="ir.ui.view">
        <field name="name">Lab Results</field>
        <field name="model">sd_health.lab_results</field>
            <field name="arch" type="xml">
                <form >
                    <sheet>
<!--                        <div class="oe_button_box" name="button_box"/>-->
<!--                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>-->
                        <div class="oe_title mb24">
                            <h1>
                                <field name="patient_id" readonly="1"/>

                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="name" placeholder="Result ID" readonly="1" invisible="1"/>
                                <field name="gender"/>
                                <field name="age"/>
                                <field name="record_date"/>
                                <field name="weight"/>
                            </group>
                            <group>
                                <field name="hba1c"/>
                                <field name="lpa"/>
                                <field name="apob"/>
                                <field name="hs_crp"/>
                                <field name="sbp"/>
                                <field name="total_chol"/>
                                <field name="hdl"/>
                                <field name="smoker" widget="boolean_toggle"/>
                                <button name="show_results" string="Results" type="object" class="btn btn-primary"/>


                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="e.g. Sight problem "/>

                        </group>
                    </sheet>

                    <chatter/>
                </form>
            </field>
    </record>

    <record id="lab_show_results_form" model="ir.ui.view">
        <field name="name">Lab Results</field>
        <field name="model">sd_health.lab_results</field>
            <field name="arch" type="xml">
                <form >
                    <sheet>
<!--                        <div class="oe_button_box" name="button_box"/>-->
<!--                        <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>-->
                        <div class="oe_title mb24">
                            <h1>
                                <field name="patient_id"  readonly="1"/>

                            </h1>
                        </div>
                        <group>
                            <group>
                                <separator string="Personal Information"/>

                                <field name="name" placeholder="Result ID" readonly="1" invisible="1"/>
                                <field name="gender" readonly="1"/>
                                <field name="age"/>
                                <field name="record_date" invisible="1"/>
                                <field name="height" readonly="1"/>
                                <field name="weight" readonly="1"/>

                                <separator string="Test Results"/>
                                <field name="hba1c" readonly="1"/>
                                <field name="lpa" readonly="1"/>
                                <field name="apob" readonly="1"/>
                                <field name="hs_crp" readonly="1"/>
                                <field name="sbp" readonly="1"/>
                                <field name="total_chol" readonly="1"/>
                                <field name="hdl" readonly="1"/>
                                <field name="smoker" widget="boolean_toggle"  readonly="1"/>
                            </group>
                            <group>
                                <separator string="Scores"/>
                                <field name="bmi"/>
                                <field name="lpa_score"/>
                                <field name="apob_score"/>
                                <field name="hba1c_score"/>
                                <field name="hscrp_score"/>
                                <field name="age_score"/>
                                <field name="bmi_score"/>
                                <field name="sbp_score"/>
                                <field name="chol_score"/>
                                <field name="smoker_score"/>
                                <field name="total_score"/>
                                <field name="risk_10yr"/>
                                <field name="risk_level" readonly="1"/>


                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="e.g. Sight problem " readonly="1"/>

                        </group>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn btn-secondary"/>
                    </footer>

                    <chatter/>
                </form>
            </field>
    </record>


    <record id="lab_results_search" model="ir.ui.view">
        <field name="name">Lab Results Search</field>
        <field name="model">sd_health.lab_results</field>
            <field name="arch" type="xml">
                <search >
                    <field name="name"/>
<!--                    <field name="medicine_type"/>-->
<!--                    <field name="dose"/>-->
<!--                    <field name="quantity"/>-->
<!--                    <field name="receive_date"/>-->
<!--                    <filter name="medicine_name" string="Name" context="{'group_by': 'name'}"/>-->
                </search>
            </field>
    </record>

    <record id="lab_show_results_act_window" model="ir.actions.act_window">
        <field name="name">Lab Result</field>
        <field name="res_model">sd_health.lab_results</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="lab_show_results_form"></field>
        <field name="target">new</field>

    </record>

    <record id="lab_results_act_window" model="ir.actions.act_window">
        <field name="name">lab_results</field>
        <field name="res_model">sd_health.lab_results</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem name="lab_results"
              id="lab_results_menu"
              parent="configuration_menu"
              action="lab_results_act_window"
              groups="sd_health.group_admins"/>

</odoo>