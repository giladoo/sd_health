<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="lab_result_a4" model="report.paperformat">
    <field name="name">Contract Daily A4 Landscape</field>
    <field name="default" eval="True"/>
    <field name="format">custom</field>
    <field name="page_height">297</field>
    <field name="page_width">210</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">37</field>
    <field name="margin_bottom">7</field>
    <field name="margin_left">0</field>
    <field name="margin_right">0</field>
    <field name="header_line" eval="False"/>
    <field name="header_spacing">30</field>
    <field name="dpi">100</field>
</record>

    <record id="lab_result_report" model="ir.actions.report">
        <field name="name">Health Report</field>
        <field name="model">sd_health.lab_results</field>
<!--        <field name="report_type">xlsx</field>-->
<!--        <field name="report_type">qweb-html</field>-->
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sd_health.lab_result_template</field>
        <field name="report_file">sd_health.lab_result_template</field>
<!--        <field name="print_report_name">(object._get_report_filename('sd_health.lab_result'))</field>-->
            <field name="print_report_name">'LabResults - %s' % (object.name)</field>
        <field name="paperformat_id" ref="lab_result_a4"/>
<!--        <field name="binding_model_id" ref="model_sd_health_lab_results"/>-->
<!--        <field name="binding_type">report</field>-->
    </record>





</odoo>
